{
  "$schema": "https://opencode.ai/config.json",

  // Enable LSP integration for language-aware code intelligence
  "lsp": true,

  // Plugins extend OpenCode functionality.
  "plugin": ["@dietrichgeberth/ponytail"],

  // Provider routing preferences (keys verified against https://models.dev):
  // OpenRouter-style `provider` routing object sent with every request to these
  // gateway providers. Upstream providers are tried in "order"; "allow_fallbacks"
  // keeps the normal behavior of moving to other providers when the ordered ones
  // are unavailable.
  //
  // - openrouter  : native OpenRouter runtime — settings.provider is forwarded
  //                 as the top-level "provider" object of the request body.
  // - nano-gpt /  : OpenAI-compatible runtimes where settings.provider is a
  //   commandcode   reserved route-identity key that never reaches the body —
  //                 the routing object is merged verbatim into every request
  //                 body via the generic body overlay instead.
  "providers": {
    "openrouter": {
      "settings": {
        "provider": {
          "order": ["anthropic", "z-ai", "deepseek", "meta", "alibaba", "minimax", "mistral", "azure", "openai", "google-vertex"],
          "allow_fallbacks": true
        }
      }
    },
    "nano-gpt": {
      "body": {
        "provider": {
          "order": ["anthropic", "z-ai", "deepseek", "meta", "alibaba", "minimax", "mistral", "azure", "openai", "google-vertex"],
          "allow_fallbacks": true
        }
      }
    },
    "commandcode": {
      "body": {
        "provider": {
          "order": ["anthropic", "z-ai", "deepseek", "meta", "alibaba", "minimax", "mistral", "azure", "openai", "google-vertex"],
          "allow_fallbacks": true
        }
      }
    }
  },

  // Permission rules: fine-grained access control for sensitive paths.
  // "read" blocks listing/reading, "edit" blocks writes, "bash" blocks CLI commands.
  "permission": {
    "read": {
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.azure/**": "deny",
      "~/.kube/**": "deny",
      "~/.docker/**": "deny",
      "~/.config/gcloud/**": "deny",
      ".env.example": "allow",
      ".env*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*credentials*": "deny"
    },
    "edit": {
      "~/.aws/**": "deny",
      "~/.azure/**": "deny",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.kube/**": "deny",
      "~/.docker/**": "deny",
      "~/.config/gcloud/**": "deny"
    },
    "bash": {
      "rm *credentials*": "deny",
      "rm *.env*": "deny"
    }
  },

  // MCP (Model Context Protocol) servers augment agent capabilities.
  // Context7 provides up-to-date library documentation at query time.
  // Set CONTEXT7_API_KEY environment variable and toggle enabled to true to activate.
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "YOUR_API_KEY"
      },
      "enabled": false
    }
  }
}
