{
  "$schema": "https://opencode.ai/config.json",

  // Enable LSP integration for language-aware code intelligence
  "lsp": true,

  // Plugins extend OpenCode functionality.
  "plugin": ["@dietrichgeberth/ponytail"],

  // OpenRouter-style routing preferences (keys verified against https://models.dev),
  // merged into every request body via the documented, package-agnostic `body`
  // overlay — the body field is per the V2 docs the home for provider-specific
  // request fields such as OpenRouter routing. Upstream providers are tried in
  // "order"; "allow_fallbacks" keeps the normal behavior of moving to other
  // providers when the ordered ones are unavailable. Provider-level values apply
  // to every model of each provider (merge order: provider → model → variant).
  "providers": {
    "openrouter": {
      "body": {
        "provider": {
          "order": ["anthropic", "z-ai", "deepseek", "meta", "alibaba", "minimax", "mistral", "azure", "openai", "google-vertex"],
          "allow_fallbacks": true
        }
      }
    },
    "nano-gpt": {
      "body": {
        "provider": {
          "order": ["anthropic", "z-ai", "deepseek", "meta", "alibaba", "minimax", "mistral", "azure", "openai", "google-vertex"],
          "allow_fallbacks": true
        }
      }
    },
    "commandcode": {
      "body": {
        "provider": {
          "order": ["anthropic", "z-ai", "deepseek", "meta", "alibaba", "minimax", "mistral", "azure", "openai", "google-vertex"],
          "allow_fallbacks": true
        }
      }
    }
  },

  // Permission rules: fine-grained access control for sensitive paths.
  // "read" blocks listing/reading, "edit" blocks writes, "bash" blocks CLI commands.
  "permission": {
    "read": {
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.azure/**": "deny",
      "~/.kube/**": "deny",
      "~/.docker/**": "deny",
      "~/.config/gcloud/**": "deny",
      ".env.example": "allow",
      ".env*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*credentials*": "deny"
    },
    "edit": {
      "~/.aws/**": "deny",
      "~/.azure/**": "deny",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.kube/**": "deny",
      "~/.docker/**": "deny",
      "~/.config/gcloud/**": "deny"
    },
    "bash": {
      "rm *credentials*": "deny",
      "rm *.env*": "deny"
    }
  },

  // MCP (Model Context Protocol) servers augment agent capabilities.
  // Context7 provides up-to-date library documentation at query time.
  // Set CONTEXT7_API_KEY environment variable and toggle enabled to true to activate.
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "YOUR_API_KEY"
      },
      "enabled": false
    }
  }
}
