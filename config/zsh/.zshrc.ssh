# ~/.zshrc — plain zsh, no plugins / frameworks.
# SSH-friendly boilerplate: zero dependencies, only built-in zsh features.
# Copy to a remote (timestamped backup first; install runs only if the backup succeeds):
#   ssh user@host 'test ! -e ~/.zshrc || cp ~/.zshrc ~/.zshrc.bak.$(date +%s)' && \
#     scp config/zsh/.zshrc.ssh user@host:~/.zshrc
#
# This uses only built-in zsh features:
# colors, completion, vcs_info (git branch), history, keybindings.

# Only do interactive setup below; PATH above still applies to scripts.
case $- in
  *i*) ;;
  *) return;;
esac

# --- History ---
HISTFILE=~/.zsh_history
HISTSIZE=5000
SAVEHIST=5000
setopt APPEND_HISTORY
setopt EXTENDED_HISTORY       # save timestamp + duration
setopt HIST_IGNORE_DUPS       # ignore consecutive duplicates
setopt HIST_FIND_NO_DUPS      # don't show dups when searching
setopt HIST_IGNORE_SPACE      # commands starting with space are not saved
setopt HIST_REDUCE_BLANKS     # trim extra blanks
setopt HIST_VERIFY            # show expanded history before running
setopt SHARE_HISTORY          # share history between sessions
setopt INC_APPEND_HISTORY     # write each command as it runs

# --- General behavior ---
setopt AUTO_CD                # `mydir` == `cd mydir`
setopt AUTO_PUSHD             # cd acts like pushd
setopt PUSHD_IGNORE_DUPS      # don't push dups onto dir stack
setopt CORRECT                # suggest correction for typos
setopt INTERACTIVE_COMMENTS   # allow `# comments` in interactive shell
setopt NO_BEEP                # no beep
setopt EXTENDED_GLOB          # extra globbing: ^, ~, #
setopt NOTIFY                 # report background jobs immediately
unsetopt FLOW_CONTROL          # let Ctrl-S / Ctrl-Q pass through (needs stty too)
stty -ixon 2>/dev/null

# --- Completion (built-in compinit, no plugins) ---
autoload -Uz compinit
compinit -i                   # -i: skip insecure-dir prompt (shared/NFS homes)
setopt COMPLETE_IN_WORD       # complete from cursor, not just end of word
setopt ALWAYS_TO_END          # move cursor to end after completion
setopt AUTO_MENU              # show menu on second Tab
setopt AUTO_LIST              # list choices on ambiguous completion
setopt AUTO_PARAM_SLASH       # add trailing slash for dirs
unsetopt MENU_COMPLETE        # don't auto-insert first match (annoying)

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'  # case-insensitive
[[ -n "$LS_COLORS" ]] && zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' rehash true                        # pick up new commands
zstyle ':completion:*' group-name ''                      # group results
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'

# --- Colors ---
autoload -U colors && colors

# --- Prompt: user@host:path (git-branch) % ---
# Looks like the classic default prompt, just colored + git aware.
setopt PROMPT_SUBST
autoload -Uz vcs_info
precmd_vcs_info() { vcs_info }
precmd_functions+=( precmd_vcs_info )
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats ' (%b)'
zstyle ':vcs_info:git:*' actionformats ' (%b|%a)'

# %# is % for normal users, # for root. Turns red if last command failed.
PROMPT='%F{green}%n@%m%f:%F{blue}%~%f%F{yellow}${vcs_info_msg_0_}%f %(?.%#.%F{red}%#%f) '
# Show non-zero exit code on the right; nothing when exit is 0 (keeps it clean).
RPROMPT='%(?..%F{red}%? ↵%f)'

# Set terminal title to user@host:dir (xterm-compatible only).
case "$TERM" in
  xterm*|rxvt*|alacritty*|foot*|wezterm*|screen*|tmux*)
    precmd_title() { print -Pn '\e]0;%n@%m: %~\a' }
    precmd_functions+=( precmd_title )
    ;;
esac

# --- ls / grep colors (no plugins) ---
if command -v dircolors >/dev/null 2>&1; then
  test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
  # LS_COLORS is only guaranteed from here on; re-apply so fresh logins get completion colors.
  zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
  alias ls='ls --color=auto'
  alias dir='dir --color=auto'
  alias vdir='vdir --color=auto'
  alias grep='grep --color=auto'
  alias fgrep='fgrep --color=auto'
  alias egrep='egrep --color=auto'
fi

# --- Handy aliases ---
alias ll='ls -lhF'
alias la='ls -A'
alias l='ls -CF'
alias lh='ls -lh'
alias ..='cd ..'
alias ...='cd ../..'

# --- Keybindings (emacs mode = zsh default) ---
bindkey -e
# Home / End / Delete / Ctrl-arrows for common terminals
bindkey '^[[H'    beginning-of-line  # Home
bindkey '^[[F'    end-of-line        # End
# Cmd+Left/Right from Ghostty/WezTerm send CSI-u line-edge sequences
# (ESC[1;9D / ESC[1;9C); bind them too so remote shells move to line edges.
bindkey '^[[1;9D' beginning-of-line  # Cmd+Left
bindkey '^[[1;9C' end-of-line        # Cmd+Right
bindkey '^[[3~'   delete-char        # Delete
bindkey '^[[1;5C' forward-word       # Ctrl+Right
bindkey '^[[1;5D' backward-word      # Ctrl+Left
bindkey '^[[A'    history-beginning-search-backward  # Up
bindkey '^[[B'    history-beginning-search-forward   # Down
# --- True Shift-selection (zero dependencies) ---
# Same mechanism as zsh-edit-select locally: first Shift-press anchors MARK
# via set-mark-command, further presses extend the highlighted region; plain
# movement clears it; typing/deleting replaces it. Bytes pass through SSH
# untouched, so these xterm sequences work remotely as-is. Without this,
# unbound ESC[1;2X falls through as literal A/B/C/D.
_sel() {
  (( REGION_ACTIVE )) || zle set-mark-command
  zle ".${WIDGET#sel-}"
}
_desel() {
  REGION_ACTIVE=0
  zle deactivate-region 2>/dev/null
  zle ".$WIDGET"
}
_ins() {
  (( REGION_ACTIVE )) && zle kill-region 2>/dev/null
  zle .self-insert
}
_del() {
  if (( REGION_ACTIVE )); then
    zle kill-region 2>/dev/null
    return
  fi
  zle ".$WIDGET"
}
for _w in backward-char forward-char backward-word forward-word \
    beginning-of-line end-of-line up-line-or-history down-line-or-history \
    history-beginning-search-backward history-beginning-search-forward \
    beginning-of-buffer-or-history end-of-buffer-or-history; do
  zle -N sel-$_w _sel
done
zle -N self-insert _ins
zle -N backward-delete-char _del
zle -N delete-char _del
for _w in backward-char forward-char backward-word forward-word \
    beginning-of-line end-of-line up-line-or-history down-line-or-history \
    history-beginning-search-backward history-beginning-search-forward \
    beginning-of-buffer-or-history end-of-buffer-or-history; do
  zle -N $_w _desel
done
unset _w
# Shift+arrows (ESC[1;2X): char/line selection.
bindkey '^[[1;2D' sel-backward-char            # Shift+Left: select 1 char left
bindkey '^[[1;2C' sel-forward-char             # Shift+Right: select 1 char right
bindkey '^[[1;2A' sel-up-line-or-history       # Shift+Up: select line up
bindkey '^[[1;2B' sel-down-line-or-history     # Shift+Down: select line down
bindkey '^[[1;2H' sel-beginning-of-line        # Shift+Home: select to line start
bindkey '^[[1;2F' sel-end-of-line              # Shift+End: select to line end
# Ctrl+Shift+arrows (ESC[1;6X): select by word.
bindkey '^[[1;6D' sel-backward-word            # Ctrl+Shift+Left: select word left
bindkey '^[[1;6C' sel-forward-word             # Ctrl+Shift+Right: select word right
# Cmd+Shift+arrows (Ghostty/WezTerm send modifier 10): select to edges.
bindkey '^[[1;10D' sel-beginning-of-line              # Cmd+Shift+Left
bindkey '^[[1;10C' sel-end-of-line                    # Cmd+Shift+Right
bindkey '^[[1;10A' sel-beginning-of-buffer-or-history # Cmd+Shift+Up
bindkey '^[[1;10B' sel-end-of-buffer-or-history       # Cmd+Shift+Down

# --- Small helpers (functions, not plugins) ---
mkcd() { mkdir -p -- "$1" && cd -- "$1" }

# --- Local overrides (optional, not tracked) ---
[ -f ~/.zshrc.local ] && source ~/.zshrc.local
